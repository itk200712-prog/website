import { PGlite } from '@electric-sql/pglite';
import { readFileSync } from 'node:fs';
import assert from 'node:assert/strict';
const db = new PGlite();
await db.exec(`
create role anon; create role authenticated; create role service_role;
create schema auth; create schema storage; create schema cron; create schema net;
create table storage.buckets(id text primary key,name text,public boolean);
create table public.profiles(id uuid primary key,role text);
create table public.backup_secrets(key text primary key,value text);
create function auth.role() returns text language sql as $$ select current_setting('request.jwt.claims',true)::jsonb->>'role' $$;
create function auth.uid() returns uuid language sql as $$ select (current_setting('request.jwt.claims',true)::jsonb->>'sub')::uuid $$;
create table cron.job(jobid bigint generated always as identity primary key,jobname text,schedule text,active boolean default true,command text);
create function cron.schedule(text,text,text) returns bigint language sql as $$ insert into cron.job(jobname,schedule,command) values($1,$2,$3) returning jobid $$;
create function cron.unschedule(bigint) returns boolean language sql as $$ delete from cron.job where jobid=$1 returning true $$;
create table net.calls(id bigint generated always as identity primary key,url text,headers jsonb,body jsonb,timeout_milliseconds int);
create function net.http_post(url text,headers jsonb,body jsonb,timeout_milliseconds int) returns bigint language sql as $$ insert into net.calls(url,headers,body,timeout_milliseconds) values($1,$2,$3,$4) returning id $$;
create table net._http_response(id bigint,status_code int,timed_out boolean,error_msg text,created timestamptz default now());
insert into public.profiles values ('12345678-1234-1234-1234-123456789abc','superadmin');
insert into public.backup_secrets values ('backup_cron_secret','aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa');
`);
let sql = readFileSync('supabase/scheduled-backup.sql','utf8');
sql = sql.replace(/^create extension[^;]+;$/gm,'');
await db.exec(sql);
let passed = 0;
const pass = (name: string) => { passed++; console.log('PASS '+name); };
assert.equal((await db.query('select * from cron.job')).rows.length,1);
pass('Single SQL installer parses and executes in real embedded PostgreSQL (cron/HTTP extensions mocked)');
await db.exec(sql);
assert.equal((await db.query('select * from cron.job')).rows.length,1);
pass('Reinstall/repair is idempotent and never creates duplicate timer jobs');
await db.exec(`select public.mpcs_backup_timer_dispatch();`);
assert.equal((await db.query('select * from net.calls')).rows[0].headers['x-backup-secret'], 'a'.repeat(48));
await db.exec(`update public.backup_secrets set value='bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' where key='backup_cron_secret'; select public.mpcs_backup_timer_dispatch();`);
assert.equal((await db.query('select * from net.calls order by id desc')).rows[0].headers['x-backup-secret'], 'b'.repeat(48));
pass('Every dispatch reads the current private secret; rotation works without rewriting cron SQL');
const dispatch = (await db.query('select * from net.calls order by id desc')).rows[0];
assert.equal(dispatch.url,'https://website-blond-eta-94.vercel.app/api/scheduled-backup');
assert.equal(dispatch.timeout_milliseconds,300000);
assert.deepEqual(dispatch.body,{});
assert(!(await db.query('select command from cron.job')).rows.some((r:any) => r.command.includes('bbbb')));
pass('Fixed production destination, 300-second timeout, no forced immediate backup and no stored secret in job commands');
await db.exec(`set role anon;`);
await assert.rejects(db.query('select public.mpcs_backup_timer_repair()'), /permission denied/);
await assert.rejects(db.query('select public.mpcs_backup_timer_status()'), /permission denied/);
await assert.rejects(db.query('select public.mpcs_backup_timer_dispatch()'), /permission denied/);
await db.exec('reset role');
pass('Anon cannot repair, inspect or dispatch backups');
await db.exec(`set role authenticated; select set_config('request.jwt.claims','{"role":"authenticated","sub":"99999999-9999-9999-9999-999999999999"}',false);`);
await assert.rejects(db.query('select public.mpcs_backup_timer_repair()'), /superadmin_required/);
await assert.rejects(db.query('select public.mpcs_backup_timer_status()'), /superadmin_required/);
await assert.rejects(db.query('select public.mpcs_backup_timer_dispatch()'), /permission denied/);
await db.exec(`reset role; insert into public.profiles values ('99999999-9999-9999-9999-999999999999','admin'); set role authenticated;`);
await assert.rejects(db.query('select public.mpcs_backup_timer_repair()'), /superadmin_required/);
await db.exec('reset role');
pass('Members and ordinary admins cannot invoke SECURITY DEFINER timer functions');
await db.exec(`set role authenticated; select set_config('request.jwt.claims','{"role":"authenticated","sub":"12345678-1234-1234-1234-123456789abc"}',false);`);
const repaired:any = (await db.query('select public.mpcs_backup_timer_repair() as value')).rows[0].value;
assert(repaired.installed && repaired.job.active && repaired.job.dynamicSecret);
await db.exec('reset role');
assert.equal((await db.query('select * from cron.job')).rows.length,1);
pass('Authenticated superadmin repairs an active single dynamic-secret job without an HTTP/backup invocation');
await db.exec(`insert into net._http_response(id,status_code,timed_out,error_msg) values (${dispatch.id},401,false,null); set role authenticated;`);
const response:any = (await db.query('select public.mpcs_backup_timer_status() as value')).rows[0].value;
assert.equal(response.lastResponse.statusCode,401);
assert(!JSON.stringify(response).includes('bbbb')); assert(!JSON.stringify(response).includes('x-backup-secret'));
await db.exec('reset role');
pass('Read-only status exposes HTTP 401 evidence but never private headers/secrets');
await db.exec(`update public.backup_secrets set value='' where key='backup_cron_secret'; set role authenticated;`);
await assert.rejects(db.query('select public.mpcs_backup_timer_repair()'), /valid Cron secret/);
await db.exec('reset role');
await assert.rejects(db.query('select public.mpcs_backup_timer_dispatch()'), /secret missing/);
pass('Missing secret fails repair/dispatch instead of falsely reporting a working timer');
await db.close();
console.log(`\n${passed} timer SQL integration tests passed (embedded PostgreSQL; mocked cron/HTTP, NOT production).`);
